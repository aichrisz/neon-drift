{
  "name": "neon-drift",
  "version": "1.0.0",
  "private": true,
  "description": "Offline neon rain traffic arcade — zero runtime dependencies",
  "scripts": {
    "start": "node scripts/server.cjs",
    "check": "node scripts/check.cjs",
    "build": "node scripts/build.cjs",
    "export": "node scripts/export.cjs",
    "test": "node --test tests/*.test.cjs && playwright test",
    "test:unit": "node --test tests/*.test.cjs",
    "test:browser": "playwright test",
    "package": "python3 scripts/package.py"
  },
  "devDependencies": {"@playwright/test": "1.64.1", "axe-core": "4.14.0"}
}
